{
  "name": "svg-composer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // /api/compose: не больше 6 запросов к LLM в минуту с одного адреса (в каждой локации Cloudflare), дальше — запасной режим
  "ratelimits": [{ "name": "COMPOSE_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }]
}
