{
  "name": "svg-composer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // /api/compose: не больше RATE_LIMIT запросов к LLM в минуту с одного адреса (src/server/compose.ts), дальше — запасной режим
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "ComposeLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComposeLimiter"] }]
}
