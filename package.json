{
  "name": "svg-composer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "figma:fetch": "node --env-file-if-exists=.env scripts/fetch-figma.mjs",
    "assets": "node scripts/build-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "examples": "vite-node scripts/make-examples.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
